---
import Layout from '../layouts/Layout.astro';
import { artSeries } from '../data/artSeries.js';
---
<Layout title="创造 — 朱萌">
  <header class="sub-header site-header"><a class="wordmark" href="/">朱萌<span> / </span>JUDY ZHU</a><nav><a href="/student-z">求知</a><a href="/work-z">践行</a><a class="active" href="/artist-z">创造</a><a href="/explorer-z">探索</a><a href="/contact">联系</a></nav><span class="header-index">Z / 03</span></header>

  <main class="artist-showcase">
    <header class="showcase-intro">
      <p class="eyebrow">Z / 03 · ARTIST</p>
      <h1>用画面与故事记录热爱</h1>
      <p>我喜欢用画面与故事记录生活中的灵感，将所见、所感与想象转化为创作。艺术于我而言，不只是技巧的展示，更是一种观察世界和理解自己的方式。虽然并非艺术专业出身，但正因如此，每一次创作都源于真实的兴趣与热爱，也让我在不断尝试中获得更多可能。</p>
    </header>

    <section class="series-deck" aria-label="艺术作品系列">
      <div class="deck-window" data-deck-window>
        <div class="deck-track" data-deck-track>
          {artSeries.map((series) => (
            <a class:list={['series-slide', `series-slide-${series.entryType}`]} href={`/art/${series.slug}`} data-deck-slide>
              <div class="slide-card">
                {series.entryType === 'image' ? (
                  <img src={series.cover} alt={`${series.title}系列入口`} />
                ) : (
                  <div class="text-cover">
                    <span>{series.index}</span>
                    <strong>{series.title}</strong>
                  </div>
                )}
                <span class="open-mark" aria-hidden="true">↗</span>
              </div>
              <div class="slide-caption">
                <div><span>{series.index}</span><h2>{series.title}</h2></div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="deck-controls">
        <button type="button" data-deck-prev aria-label="查看上一个系列">←</button>
        <div class="deck-dots" aria-label="系列页码">
          {artSeries.map((series, index) => <button type="button" class:list={{ active: index === 0 }} data-deck-dot={index} aria-label={`查看${series.title}`}></button>)}
        </div>
        <button type="button" data-deck-next aria-label="查看下一个系列">→</button>
      </div>
    </section>
  </main>

  <footer class="site-footer"><span>© 2026 MENG ZHU</span><a href="/">回到首页 ↑</a></footer>

  <style>
    .artist-showcase {
      --showcase-paper: #eef0ed;
      --showcase-ink: #20231f;
      --showcase-line: rgba(32, 35, 31, .22);
      --showcase-accent: #f36e57;
      background: var(--showcase-paper);
      color: var(--showcase-ink);
      min-height: calc(100vh - 77px);
      overflow: hidden;
      padding: clamp(42px, 7vh, 90px) 0 clamp(36px, 6vh, 72px);
    }

    .showcase-intro {
      margin: 0 auto clamp(34px, 5vh, 64px);
      max-width: 1200px;
      padding: 0 max(5vw, 26px);
    }

    .showcase-intro .eyebrow { color: var(--showcase-accent); }
    .showcase-intro h1 { font-family: var(--serif); font-size: 88px; font-weight: 400; letter-spacing: -.04em; line-height: .95; margin: 40px 0 55px; white-space: nowrap; }
    .showcase-intro > p:last-child { color: var(--muted); font-family: var(--serif); font-size: 25px; line-height: 1.55; margin: 0; max-width: 980px; }

    .series-deck { margin: 0 auto; max-width: 1560px; }
    .deck-window { overflow: hidden; }
    .deck-track {
      display: flex;
      gap: clamp(16px, 2vw, 34px);
      overflow-x: auto;
      padding: 0 calc((100% - min(64vw, 820px)) / 2) 16px;
      scrollbar-width: none;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      touch-action: pan-x;
    }
    .deck-track::-webkit-scrollbar { display: none; }

    .series-slide { color: inherit; flex: 0 0 min(64vw, 820px); min-width: 0; scroll-snap-align: center; }
    .slide-card { aspect-ratio: 16 / 9; background: #e2e5df; overflow: hidden; position: relative; }
    .slide-card > img { background: #f7f5ef; display: block; height: 100%; object-fit: contain; transition: transform .5s ease; width: 100%; }
    .series-slide:hover .slide-card > img { transform: scale(1.015); }
    .open-mark { align-items: center; background: var(--showcase-ink); color: var(--showcase-paper); display: flex; font-size: 20px; height: 42px; justify-content: center; position: absolute; right: 16px; top: 16px; width: 42px; }

    .text-cover { align-items: flex-start; background: #d9ef68; display: flex; flex-direction: column; height: 100%; justify-content: flex-end; padding: clamp(28px, 5vw, 70px); }
    .series-slide:nth-child(5) .text-cover { background: #bfd5ff; }
    .text-cover span { font-size: 13px; letter-spacing: .08em; margin-bottom: auto; }
    .text-cover strong { font-family: var(--serif); font-size: clamp(48px, 7vw, 96px); font-weight: 400; letter-spacing: -.05em; line-height: .95; }
    .text-cover p { font-size: 15px; line-height: 1.7; margin: 18px 0 0; max-width: 330px; }

    .slide-caption { align-items: flex-start; border-bottom: 1px solid var(--showcase-line); display: flex; justify-content: space-between; min-height: 70px; padding: 13px 0 16px; }
    .slide-caption > div { align-items: baseline; display: flex; gap: 14px; }
    .slide-caption span { color: var(--muted); font-size: 11px; letter-spacing: .08em; }
    .slide-caption h2 { font-family: var(--serif); font-size: clamp(25px, 3vw, 40px); font-weight: 400; letter-spacing: -.03em; line-height: 1; margin: 0; }

    .deck-controls { align-items: center; display: flex; gap: 18px; justify-content: center; margin-top: 28px; }
    .deck-controls > button { align-items: center; background: transparent; border: 1px solid var(--showcase-line); color: var(--showcase-ink); cursor: pointer; display: inline-flex; font-size: 17px; height: 38px; justify-content: center; padding: 0; transition: background .2s, color .2s; width: 42px; }
    .deck-controls > button:hover, .deck-controls > button:focus-visible { background: var(--showcase-ink); color: var(--showcase-paper); outline: none; }
    .deck-dots { display: flex; gap: 7px; }
    .deck-dots button { background: rgba(32, 35, 31, .25); border: 0; border-radius: 99px; cursor: pointer; height: 8px; padding: 0; transition: background .2s, width .2s; width: 8px; }
    .deck-dots button.active { background: var(--showcase-accent); width: 30px; }

    @media (max-width: 800px) {
      .artist-showcase { min-height: calc(100vh - 65px); padding-top: 46px; }
      .showcase-intro { margin-bottom: 36px; }
      .showcase-intro h1 { font-size: 58px; max-width: 100%; white-space: normal; }
      .showcase-intro > p:last-child { font-size: 22px; max-width: 100%; }
      .deck-track { gap: 14px; padding-left: 12vw; padding-right: 12vw; }
      .series-slide { flex-basis: 76vw; }
      .slide-card { aspect-ratio: 4 / 5; }
      .text-cover strong { font-size: 52px; }
      .slide-caption { min-height: 61px; }
      .deck-controls { margin-top: 20px; }
    }
  </style>

  <script>
    const track = document.querySelector('[data-deck-track]');
    const slides = [...document.querySelectorAll('[data-deck-slide]')];
    const dots = [...document.querySelectorAll('[data-deck-dot]')];
    const previous = document.querySelector('[data-deck-prev]');
    const next = document.querySelector('[data-deck-next]');
    let activeIndex = 0;
    let wheelLocked = false;

    const setActive = (index, shouldScroll = false) => {
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === activeIndex));
      if (shouldScroll) slides[activeIndex]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    previous?.addEventListener('click', () => setActive(activeIndex - 1, true));
    next?.addEventListener('click', () => setActive(activeIndex + 1, true));
    dots.forEach((dot, index) => dot.addEventListener('click', () => setActive(index, true)));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(slides.indexOf(entry.target));
      });
    }, { root: track, threshold: .6 });
    slides.forEach((slide) => observer.observe(slide));

    track?.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaY) <= Math.abs(event.deltaX) || wheelLocked) return;
      event.preventDefault();
      wheelLocked = true;
      setActive(activeIndex + (event.deltaY > 0 ? 1 : -1), true);
      window.setTimeout(() => { wheelLocked = false; }, 520);
    }, { passive: false });
  </script>
</Layout>
